GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Generate a strong bearer token with:  openssl rand -hex 32
# (required at startup unless the server binds to a loopback MCP_HOST)
MCP_BEARER_TOKEN=
# GTASKS_DEFAULT_LIST=@default  # list ids aren't shown in the Tasks UI: uv run python find_list_id.py
# GTASKS_API_BASE=https://tasks.googleapis.com
# HTTP bind address and port (defaults: 0.0.0.0 and 8080).
# Use MCP_HOST=127.0.0.1 for local-only access (bearer token then optional).
# MCP_HOST=0.0.0.0
# MCP_PORT=8080
# Extra Host headers accepted by the built-in Host/Origin guard, comma-separated.
# localhost, 127.0.0.1 and ::1 are always allowed. Behind a Cloudflare tunnel,
# add the public hostname, e.g.:  MCP_ALLOWED_HOSTS=gtasks.example.com
# MCP_ALLOWED_HOSTS=
